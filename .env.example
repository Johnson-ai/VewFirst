# Copy to .env (or export these variables) before running in production.
PORT=3000
APP_NAME=ViewFirst
# ISO currency code used for prices (NGN, GHS, KES, ZAR, USD, GBP ...)
CURRENCY=NGN
LOCALE=en-NG
# Map centre used when no listings exist yet (Lagos by default)
MAP_CENTER_LAT=6.5244
MAP_CENTER_LNG=3.3792
# Only verified landlords can publish listings. Set to false for local experiments.
REQUIRE_VERIFICATION=true
# First admin account, created automatically on first start.
ADMIN_EMAIL=admin@viewfirst.local
ADMIN_PASSWORD=change-me-now-please
# Set to true when serving over HTTPS so cookies are marked Secure.
COOKIE_SECURE=false
DATA_DIR=./data
